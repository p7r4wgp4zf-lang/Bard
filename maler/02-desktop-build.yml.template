# Aktiver først når /app finnes og har npm-lockfil og src-tauri/Cargo.lock.
# Kopier til .github/workflows/02-desktop-build.yml etter lokal byggtest.
# Bygg kun ved manuell start. Ingen automatisk publisering/release.
name: 02 Desktop build (manual)

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  desktop:
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: macos-latest
            name: macos-arm64
          - os: macos-15-intel
            name: macos-intel
          - os: windows-latest
            name: windows-x64
    runs-on: ${{ matrix.os }}
    timeout-minutes: 45
    steps:
      - name: Checkout (v7.0.1)
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - name: Node.js 24 (setup-node v7.1.0)
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1
        with:
          node-version: '24'
          package-manager-cache: false
      - name: Install Rust toolchain
        shell: bash
        run: |
          rustup toolchain install stable --profile minimal
          rustup default stable
      - name: Install frontend from lockfile
        working-directory: app
        run: npm ci --no-fund
      - name: Compile web UI
        working-directory: app
        run: npm run build
      - name: Build Tauri desktop packages
        working-directory: app
        run: npm run tauri build
      - name: Upload private build artifact (v4.6.2)
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: gitarstemme-${{ matrix.name }}
          path: app/src-tauri/target/release/bundle/**
          if-no-files-found: error
          retention-days: 7
# Kjent begrensning: Uten Apple Developer ID / Windows-kodesignering
# får man usignerte build-artefakter som kan utløse OS-advarsler.
# Før release: kontroll av Rust-versjon, låsing, code signing og SBOM.
